                        <option value="def_normal">Validación, comprensión y legitimación del comportamiento o sentir ajeno.</option>
                        <option value="def_rechazo_moral">Rechazo violento ante una conducta o estímulo insoportable.</option>
                        <option value="def_estupor_trans">Sensación provocada por un acontecimiento extraordinario.</option>
                    </select>
                </div>
                <div class="emo-select-group">
                    <span class="emo-select-label">Registro de habla:</span>
                    <select class="emo-select sel-reg">
                        <option value="">-- Elige registro --</option>
                        <option value="estandar_neutro">Estándar / Neutro</option>
                        <option value="muy_coloquial">Muy coloquial / Juvenil</option>
                        <option value="vulgar">Vulgar</option>
                    </select>
                </div>
            </div>
            <div class="emo-feedback-box" id="p4_fb_8">
                💡 <b>Clave:</b> <b>Alivio y empatía</b>. Sirve para validar la reacción de otra persona y tranquilizarla («Estaba agotado y me fui a dormir. —Normal, llevabas diez horas trabajando»). Registro <b>Estándar / Neutro</b>.
            </div>
        </div>
    </div>

    <!-- КНОПКИ -->
    <div class="emo-control-bar">
        <button type="button" class="emo-ctrl-btn emo-btn-check" onclick="checkComboPart4()">✅ Comprobar</button>
        <button type="button" class="emo-ctrl-btn emo-btn-show" onclick="showComboPart4()">👁️ Mostrar respuestas y explicaciones</button>
        <button type="button" class="emo-ctrl-btn emo-btn-reset" onclick="resetComboPart4()">🔄 Reiniciar</button>
    </div>

    <!-- ВЫВОД БАЛЛОВ -->
    <div id="emoScoreBox4"></div>

    <script>
        function checkComboPart4() {
            const cards = document.querySelectorAll('#combo-emociones-b1-part4-2026 .emo-row-card');
            const totalFields = cards.length * 3;
            let correctFields = 0;

            cards.forEach(card => {
                const targetCat = card.getAttribute('data-cat');
                const targetDef = card.getAttribute('data-def');
                const targetReg = card.getAttribute('data-reg');

                const selCat = card.querySelector('.sel-cat');
                const selDef = card.querySelector('.sel-def');
                const selReg = card.querySelector('.sel-reg');

                if (selCat.value === targetCat) {
                    selCat.className = 'emo-select sel-cat is-correct';
                    correctFields++;
                } else {
                    selCat.className = 'emo-select sel-cat is-wrong';
                }

                if (selDef.value === targetDef) {
                    selDef.className = 'emo-select sel-def is-correct';
                    correctFields++;
                } else {
                    selDef.className = 'emo-select sel-def is-wrong';
                }

                if (selReg.value === targetReg) {
                    selReg.className = 'emo-select sel-reg is-correct';
                    correctFields++;
                } else {
                    selReg.className = 'emo-select sel-reg is-wrong';
                }

                const idx = card.getAttribute('data-idx');
                const fb = document.getElementById('p4_fb_' + idx);
                if (fb) fb.style.display = 'block';
            });

            const scoreBox = document.getElementById('emoScoreBox4');
            scoreBox.innerHTML = `📊 Puntuación Parte 4: ${correctFields} de ${totalFields} parámetros correctos (${Math.round((correctFields/totalFields)*100)}%)`;
            scoreBox.style.display = 'block';
            scoreBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function showComboPart4() {
            const cards = document.querySelectorAll('#combo-emociones-b1-part4-2026 .emo-row-card');
            cards.forEach(card => {
                const targetCat = card.getAttribute('data-cat');
                const targetDef = card.getAttribute('data-def');
                const targetReg = card.getAttribute('data-reg');

                const selCat = card.querySelector('.sel-cat');
                const selDef = card.querySelector('.sel-def');
                const selReg = card.querySelector('.sel-reg');

                selCat.value = targetCat;
                selCat.className = 'emo-select sel-cat is-correct';

                selDef.value = targetDef;
                selDef.className = 'emo-select sel-def is-correct';

                selReg.value = targetReg;
                selReg.className = 'emo-select sel-reg is-correct';

                const idx = card.getAttribute('data-idx');
                const fb = document.getElementById('p4_fb_' + idx);
                if (fb) fb.style.display = 'block';
            });

            const scoreBox = document.getElementById('emoScoreBox4');
            scoreBox.innerHTML = `🔑 Claves pragmáticas y respuestas correctas desbloqueadas.`;
            scoreBox.style.display = 'block';
        }

        function resetComboPart4() {
            const cards = document.querySelectorAll('#combo-emociones-b1-part4-2026 .emo-row-card');
            cards.forEach(card => {
                const selCat = card.querySelector('.sel-cat');
                const selDef = card.querySelector('.sel-def');
                const selReg = card.querySelector('.sel-reg');

                selCat.value = '';
                selCat.className = 'emo-select sel-cat';

                selDef.value = '';
                selDef.className = 'emo-select sel-def';

                selReg.value = '';
                selReg.className = 'emo-select sel-reg';

                const idx = card.getAttribute('data-idx');
                const fb = document.getElementById('p4_fb_' + idx);
                if (fb) fb.style.display = 'none';
            });

            const scoreBox = document.getElementById('emoScoreBox4');
            scoreBox.style.display = 'none';
            scoreBox.innerHTML = '';
        }
    </script>
</div>
