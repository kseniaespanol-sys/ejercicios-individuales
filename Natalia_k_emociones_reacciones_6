                        <option value="def_pregunta_d">Pregunta retórica que expresa perplejidad y desacuerdo.</option>
                    </select>
                </div>
                <div class="emo-select-group">
                    <span class="emo-select-label">Registro de habla:</span>
                    <select class="emo-select sel-reg">
                        <option value="">-- Elige registro --</option>
                        <option value="formal">Estándar / Formal</option>
                        <option value="coloquial">Coloquial</option>
                        <option value="vulgar">Vulgar</option>
                    </select>
                </div>
            </div>
            <div class="emo-feedback-box" id="p6_fb_8">
                💡 <b>Clave:</b> <b>Alivio y empatía</b>. Frena la confrontación y valida el punto de vista del interlocutor («No pude avisarte antes. —Bueno, claro, entiendo que estabas liado»). Registro <b>Coloquial</b>.
            </div>
        </div>
    </div>

    <!-- КНОПКИ -->
    <div class="emo-control-bar">
        <button type="button" class="emo-ctrl-btn emo-btn-check" onclick="checkComboPart6()">✅ Comprobar</button>
        <button type="button" class="emo-ctrl-btn emo-btn-show" onclick="showComboPart6()">👁️ Mostrar respuestas y explicaciones</button>
        <button type="button" class="emo-ctrl-btn emo-btn-reset" onclick="resetComboPart6()">🔄 Reiniciar</button>
    </div>

    <!-- ВЫВОД БАЛЛОВ -->
    <div id="emoScoreBox6"></div>

    <script>
        function checkComboPart6() {
            const cards = document.querySelectorAll('#combo-emociones-b1-part6-2026 .emo-row-card');
            const totalFields = cards.length * 3;
            let correctFields = 0;

            cards.forEach(card => {
                const targetCat = card.getAttribute('data-cat');
                const targetDef = card.getAttribute('data-def');
                const targetReg = card.getAttribute('data-reg');

                const selCat = card.querySelector('.sel-cat');
                const selDef = card.querySelector('.sel-def');
                const selReg = card.querySelector('.sel-reg');

                if (selCat.value === targetCat) {
                    selCat.className = 'emo-select sel-cat is-correct';
                    correctFields++;
                } else {
                    selCat.className = 'emo-select sel-cat is-wrong';
                }

                if (selDef.value === targetDef) {
                    selDef.className = 'emo-select sel-def is-correct';
                    correctFields++;
                } else {
                    selDef.className = 'emo-select sel-def is-wrong';
                }

                if (selReg.value === targetReg) {
                    selReg.className = 'emo-select sel-reg is-correct';
                    correctFields++;
                } else {
                    selReg.className = 'emo-select sel-reg is-wrong';
                }

                const idx = card.getAttribute('data-idx');
                const fb = document.getElementById('p6_fb_' + idx);
                if (fb) fb.style.display = 'block';
            });

            const scoreBox = document.getElementById('emoScoreBox6');
            scoreBox.innerHTML = `📊 Puntuación Parte 6: ${correctFields} de ${totalFields} parámetros correctos (${Math.round((correctFields/totalFields)*100)}%)`;
            scoreBox.style.display = 'block';
            scoreBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function showComboPart6() {
            const cards = document.querySelectorAll('#combo-emociones-b1-part6-2026 .emo-row-card');
            cards.forEach(card => {
                const targetCat = card.getAttribute('data-cat');
                const targetDef = card.getAttribute('data-def');
                const targetReg = card.getAttribute('data-reg');

                const selCat = card.querySelector('.sel-cat');
                const selDef = card.querySelector('.sel-def');
                const selReg = card.querySelector('.sel-reg');

                selCat.value = targetCat;
                selCat.className = 'emo-select sel-cat is-correct';

                selDef.value = targetDef;
                selDef.className = 'emo-select sel-def is-correct';

                selReg.value = targetReg;
                selReg.className = 'emo-select sel-reg is-correct';

                const idx = card.getAttribute('data-idx');
                const fb = document.getElementById('p6_fb_' + idx);
                if (fb) fb.style.display = 'block';
            });

            const scoreBox = document.getElementById('emoScoreBox6');
            scoreBox.innerHTML = `🔑 Claves pragmáticas y respuestas correctas desbloqueadas.`;
            scoreBox.style.display = 'block';
        }

        function resetComboPart6() {
            const cards = document.querySelectorAll('#combo-emociones-b1-part6-2026 .emo-row-card');
            cards.forEach(card => {
                const selCat = card.querySelector('.sel-cat');
                const selDef = card.querySelector('.sel-def');
                const selReg = card.querySelector('.sel-reg');

                selCat.value = '';
                selCat.className = 'emo-select sel-cat';

                selDef.value = '';
                selDef.className = 'emo-select sel-def';

                selReg.value = '';
                selReg.className = 'emo-select sel-reg';

                const idx = card.getAttribute('data-idx');
                const fb = document.getElementById('p6_fb_' + idx);
                if (fb) fb.style.display = 'none';
            });

            const scoreBox = document.getElementById('emoScoreBox6');
            scoreBox.style.display = 'none';
            scoreBox.innerHTML = '';
        }
    </script>
</div>
