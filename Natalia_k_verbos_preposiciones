                        <input type="text" class="rv-input" placeholder="sobre / de" autocomplete="off">
                        <div class="rv-expected"></div>
                    </td>
                    <td>
                        Referirse a una temática particular; ser el asunto central de una obra, texto o reunión.
                    </td>
                </tr>

                <!-- 30. Tratar con -->
                <tr data-answers='["con", "con (+ persona / entidad)"]' data-hint="con (+ persona / entidad)">
                    <td class="rv-verb-cell">Tratar (contacto)</td>
                    <td>
                        <input type="text" class="rv-input" placeholder="¿Preposición?" autocomplete="off">
                        <div class="rv-expected"></div>
                    </td>
                    <td>
                        Mantener contacto profesional, gestionar o comunicarse habitualmente con alguien.
                    </td>
                </tr>

                <!-- 31. Probar (cosa) -->
                <tr data-answers='["sin", "sin preposicion", "sin preposición", "-", "ninguna", "nada"]' data-hint="sin preposición (+ sust.)">
                    <td class="rv-verb-cell">Probar (cosa)</td>
                    <td>
                        <input type="text" class="rv-input" placeholder="sin preposición / -" autocomplete="off">
                        <div class="rv-expected"></div>
                    </td>
                    <td>
                        <span class="rv-tooltip">Degustar<span class="rv-tiptext">дегустировать / пробовать на вкус</span></span> comida o bebida, ponerse ropa para ver si queda bien, o testear maquinaria/código.
                    </td>
                </tr>

                <!-- 32. Probar a -->
                <tr data-answers='["a", "a (+ inf.)", "a + inf"]' data-hint="a (+ inf.)">
                    <td class="rv-verb-cell">Probar (ensayo)</td>
                    <td>
                        <input type="text" class="rv-input" placeholder="¿Preposición?" autocomplete="off">
                        <div class="rv-expected"></div>
                    </td>
                    <td>
                        Experimentar una acción novedosa a modo de sugerencia o <span class="rv-tooltip">ensayo<span class="rv-tiptext">проба / попытка / эксперимент</span></span> para comprobar si funciona.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Кнопки управления -->
    <div class="rv-control-bar">
        <button type="button" class="rv-ctrl-btn rv-btn-check" onclick="checkRegimenVerbal()">✅ Comprobar</button>
        <button type="button" class="rv-ctrl-btn rv-btn-show" onclick="showRegimenVerbal()">👁️ Mostrar soluciones</button>
        <button type="button" class="rv-ctrl-btn rv-btn-reset" onclick="resetRegimenVerbal()">🔄 Reiniciar</button>
    </div>

    <!-- Блок баллов -->
    <div id="rvScoreBox"></div>

    <script>
        function normalizeRV(str) {
            return (str || '')
                .toLowerCase()
                .trim()
                .replace(/[.,\/#!$%\^&\*;:{}=\-_`~()?¡!…«»"]/g, '')
                .replace(/\s+/g, ' ');
        }

        function checkRegimenVerbal() {
            const rows = document.querySelectorAll('#rvTableBody tr');
            let correctCount = 0;
            const total = rows.length;

            rows.forEach(row => {
                const input = row.querySelector('.rv-input');
                const expBox = row.querySelector('.rv-expected');
                const userVal = normalizeRV(input.value);

                let validAnswers = [];
                try {
                    validAnswers = JSON.parse(row.getAttribute('data-answers') || '[]');
                } catch(e) {
                    validAnswers = [];
                }

                const cleanAnswers = validAnswers.map(a => normalizeRV(a));
                const isCorrect = cleanAnswers.some(ans => ans === userVal || (userVal.length > 0 && ans.split(' ').includes(userVal)));

                input.classList.remove('correct', 'wrong');

                if (userVal.length > 0 && isCorrect) {
                    input.classList.add('correct');
                    correctCount++;
                    expBox.style.display = 'none';
                } else {
                    input.classList.add('wrong');
                    expBox.innerText = '👉 ' + row.getAttribute('data-hint');
                    expBox.style.display = 'block';
                }
            });

            const scoreBox = document.getElementById('rvScoreBox');
            const pct = Math.round((correctCount / total) * 100);
            scoreBox.innerHTML = `📊 Puntuación: <b>${correctCount}</b> de <b>${total}</b> correctas (${pct}%).`;
            scoreBox.style.display = 'block';
            scoreBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function showRegimenVerbal() {
            const rows = document.querySelectorAll('#rvTableBody tr');
            rows.forEach(row => {
                const input = row.querySelector('.rv-input');
                const expBox = row.querySelector('.rv-expected');
                const hint = row.getAttribute('data-hint');

                input.value = hint;
                input.classList.remove('wrong');
                input.classList.add('correct');
                expBox.style.display = 'none';
            });

            const scoreBox = document.getElementById('rvScoreBox');
            scoreBox.innerHTML = `🔑 Todas las soluciones han sido insertadas. ¡Pasa el ratón por los términos subrayados para ver las definiciones!`;
            scoreBox.style.display = 'block';
        }

        function resetRegimenVerbal() {
            const rows = document.querySelectorAll('#rvTableBody tr');
            rows.forEach(row => {
                const input = row.querySelector('.rv-input');
                const expBox = row.querySelector('.rv-expected');

                input.value = '';
                input.className = 'rv-input';
                expBox.style.display = 'none';
                expBox.innerText = '';
            });

            const scoreBox = document.getElementById('rvScoreBox');
            scoreBox.style.display = 'none';
            scoreBox.innerHTML = '';
        }
    </script>
</div>
