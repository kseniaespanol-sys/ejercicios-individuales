                .toLowerCase()
                .trim()
                .replace(/[.,\/#!$%\^&\*;:{}=\-_`~()?¡!…«»"]/g, '')
                .replace(/\s+/g, ' ');
        }

        function checkGuidedPractice() {
            const lines = document.querySelectorAll('#guided-practice-b1-2026 .gp-line');
            let correctCount = 0;
            const totalLines = lines.length;

            lines.forEach(line => {
                const input = line.querySelector('.gp-input');
                const rawUser = input.value;
                const cleanUser = normalizeText(rawUser);

                let targets = [];
                try {
                    targets = JSON.parse(line.getAttribute('data-targets') || '[]');
                } catch(e) {
                    targets = [];
                }

                const cleanTargets = targets.map(t => normalizeText(t));
                const isMatch = cleanTargets.some(t => t === cleanUser || (cleanUser.length > 2 && t.includes(cleanUser)));

                input.classList.remove('is-correct', 'is-wrong');

                if (cleanUser && isMatch) {
                    input.classList.add('is-correct');
                    correctCount++;
                } else if (cleanUser) {
                    input.classList.add('is-wrong');
                }

                line.querySelector('.gp-inline-answer').style.display = 'block';
            });

            const scoreBox = document.getElementById('gpScoreBox');
            const pct = Math.round((correctCount / totalLines) * 100);
            scoreBox.innerHTML = `📊 Resultado: ${correctCount} de ${totalLines} aciertos (${pct}%). Revisa las claves verdes en cada línea para comparar tus respuestas.`;
            scoreBox.style.display = 'block';
            scoreBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function showGuidedPracticeKeys() {
            const lines = document.querySelectorAll('#guided-practice-b1-2026 .gp-line');
            lines.forEach(line => {
                let targets = [];
                try {
                    targets = JSON.parse(line.getAttribute('data-targets') || '[]');
                } catch(e) {
                    targets = [];
                }
                const input = line.querySelector('.gp-input');
                if (targets.length > 0) {
                    input.value = targets[0];
                    input.classList.remove('is-wrong');
                    input.classList.add('is-correct');
                }
                line.querySelector('.gp-inline-answer').style.display = 'block';
            });

            const scoreBox = document.getElementById('gpScoreBox');
            scoreBox.innerHTML = `🔑 Claves sugeridas insertadas. ¡Léelas en voz alta para practicar la entonación!`;
            scoreBox.style.display = 'block';
        }

        function resetGuidedPractice() {
            const lines = document.querySelectorAll('#guided-practice-b1-2026 .gp-line');
            lines.forEach(line => {
                const input = line.querySelector('.gp-input');
                input.value = '';
                input.className = 'gp-input';
                line.querySelector('.gp-inline-answer').style.display = 'none';
            });

            const scoreBox = document.getElementById('gpScoreBox');
            scoreBox.style.display = 'none';
            scoreBox.innerHTML = '';
        }
    </script>
</div>
