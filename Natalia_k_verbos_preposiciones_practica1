    <!-- БЛОК С РЕЗУЛЬТАТАМИ -->
    <div id="dgScoreBox"></div>

    <script>
        function cleanVal(str) {
            return (str || '')
                .toLowerCase()
                .trim()
                .replace(/[.,\/#!$%\^&\*;:{}=\-_`~()?¡!…«»"]/g, '')
                .replace(/\s+/g, ' ');
        }

        function checkDialogues() {
            const inputs = document.querySelectorAll('#dialogos-preposiciones-b1-2026 .dg-input');
            let correctCount = 0;
            const total = inputs.length;

            inputs.forEach(input => {
                const userVal = cleanVal(input.value);
                let valid = [];
                try {
                    valid = JSON.parse(input.getAttribute('data-ans') || '[]');
                } catch (e) {
                    valid = [];
                }

                const cleanTargets = valid.map(t => cleanVal(t));
                const isMatch = cleanTargets.some(t => {
                    if (t === '-' || t === 'sin' || t === 'sin preposicion') {
                        return userVal === '-' || userVal === 'sin' || userVal === 'sin prep' || userVal === 'nada' || userVal === '';
                    }
                    return t === userVal;
                });

                input.classList.remove('is-correct', 'is-wrong');

                if (isMatch && (userVal.length > 0 || cleanTargets.includes('-'))) {
                    input.classList.add('is-correct');
                    correctCount++;
                } else {
                    input.classList.add('is-wrong');
                }
            });

            document.querySelectorAll('#dialogos-preposiciones-b1-2026 .dg-feedback').forEach(fb => {
                fb.style.display = 'block';
            });

            const scoreBox = document.getElementById('dgScoreBox');
            const pct = Math.round((correctCount / total) * 100);
            scoreBox.innerHTML = `📊 Resultado: <b>${correctCount}</b> de <b>${total}</b> preposiciones correctas (${pct}%).`;
            scoreBox.style.display = 'block';
            scoreBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function showDialogueKeys() {
            const inputs = document.querySelectorAll('#dialogos-preposiciones-b1-2026 .dg-input');
            inputs.forEach(input => {
                const hint = input.getAttribute('data-hint') || '';
                input.value = hint.startsWith('sin prep') ? '-' : hint.split('/')[0].trim();
                input.classList.remove('is-wrong');
                input.classList.add('is-correct');
            });

            document.querySelectorAll('#dialogos-preposiciones-b1-2026 .dg-feedback').forEach(fb => {
                fb.style.display = 'block';
            });

            const scoreBox = document.getElementById('dgScoreBox');
            scoreBox.innerHTML = `🔑 Todas las soluciones insertadas con éxito.`;
            scoreBox.style.display = 'block';
        }

        function resetDialogues() {
            const inputs = document.querySelectorAll('#dialogos-preposiciones-b1-2026 .dg-input');
            inputs.forEach(input => {
                input.value = '';
                input.className = 'dg-input';
            });

            document.querySelectorAll('#dialogos-preposiciones-b1-2026 .dg-feedback').forEach(fb => {
                fb.style.display = 'none';
            });

            const scoreBox = document.getElementById('dgScoreBox');
            scoreBox.style.display = 'none';
            scoreBox.innerHTML = '';
        }
    </script>
